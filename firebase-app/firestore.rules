rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to read public styles
    match /artifacts/image-decorator-v2/public/data/styles/{styleId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email != null;
    }

    // Gallery - authenticated users can read/write their own, admin can delete
    match /artifacts/image-decorator-v2/public/data/gallery/{imageId} {
      allow read: if request.auth != null && request.auth.token.email != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.token.email != null;
    }
  }
}
